<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Capability „Near Field Communication Tag Reading".
	     Nur TAG: wir nutzen NFCTagReaderSession (roher Tag-Zugriff + NDEF-Schreiben
	     ueber den Tag). Das Format NDEF ist nur fuer NFCNDEFReaderSession und wird
	     vom neueren SDK zusammen mit min iOS 17 abgelehnt ("NDEF is disallowed"). -->
	<key>com.apple.developer.nfc.readersession.formats</key>
	<array>
		<string>TAG</string>
	</array>
</dict>
</plist>
