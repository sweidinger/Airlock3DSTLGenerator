# Kopiere diese Datei nach .env und passe die Werte an.

# Gemeinsames Geheimnis zwischen KG-Tracker und Generator (Pflicht).
AIRLOCK_API_KEY=bitte-langes-zufaelliges-secret-einsetzen

# Maximale Anzahl Locks pro Batch.
AIRLOCK_MAX_BATCH=200

# Dashboard-Komfort: 1 = Server spritzt den API-Key automatisch ins Dashboard,
# sodass es ohne Eingabe verbindet. ACHTUNG: Der Key ist dann im Seitenquelltext
# sichtbar -> nur in einem vertrauten LAN aktivieren. 0 = aus (Standard).
AIRLOCK_UI_AUTOKEY=0

# NFC-Signierung: Geheimnis fuer HMAC(Code|Tag-UID). PFLICHT im Betrieb.
# Dasselbe Secret braucht spaeter der KG-Tracker zum Offline-Verifizieren der
# Tags (oder er ruft den /nfc/verify-Endpunkt des Generators auf).
AIRLOCK_NFC_SECRET=bitte-eigenes-langes-nfc-secret-einsetzen
