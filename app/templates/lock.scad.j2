// Airlock-STL-Generator — parametrisiertes OpenSCAD-Template
// Erzeugt aus der leeren Vorlage eine Airlock-STL mit erhabener Nummer.
// Alle Werte werden vom Python-Generator (generator.py) eingesetzt.
//
// `part` steuert, was gerendert wird:
//   "both" -> Vorlage + Code als ein Volumen (Standard, Einzel-STL)
//   "body" -> Vorlage MINUS Code-Volumen (Aussparung, für Mehrfarb-3MF, schwarz)
//   "code" -> nur das Code-Volumen (füllt die Aussparung, für Mehrfarb-3MF, weiß)

code    = "{{ code }}";
size    = {{ size }};
xscale  = {{ xscale }};
depth   = {{ depth }};
tx      = {{ tx }};
ty      = {{ ty }};
font    = "{{ font }}";
topz    = {{ topz }};
sink    = {{ sink }};
part    = "{{ part }}";

module lock_base() {
    // Vorlage ausrichten: optional drehen, dann min-Ecke in den Ursprung normalisieren.
    translate([{{ tr_x }}, {{ tr_y }}, {{ tr_z }}])
        rotate([{{ rot_x }}, {{ rot_y }}, {{ rot_z }}])
            import("{{ base_stl }}");
}

module code_solid() {
    // Code ins abgesenkte Zahlenfeld praegen: von (topz - sink) bis (topz + depth).
    // topz = Feldboden, depth = Recess-Tiefe -> Oberkante buendig mit der Oberflaeche.
    // `sink` reicht unter den Feldboden -> sauberer Verbund/Aussparung.
    translate([tx, ty, topz - sink])
        scale([xscale, 1, 1])
            linear_extrude(height = depth + sink)
                text(code, size = size, font = font,
                     halign = "{{ halign }}", valign = "{{ valign }}");
{% if frame_enable %}
    // Weisser Rahmen am Tag-Taschenrand (Code-Farbe): duenner Ring rund um die
    // Taschenoeffnung, endet an der Pausenebene -> bei der 3-mm-Pause sichtbare
    // Markierung fuers Einlegen des Tags. Wird beim Weiterdrucken ueberdeckt.
    translate([tx, ty, {{ frame_z0 }}])
        linear_extrude(height = {{ frame_z1 }} - ({{ frame_z0 }}))
            difference() {
                square([{{ frame_out_x }}, {{ frame_out_y }}], center = true);
                square([{{ frame_in_x }}, {{ frame_in_y }}], center = true);
            }
{% endif %}
}

if (part == "code") {
    code_solid();
} else if (part == "body") {
    difference() {
        lock_base();
        code_solid();
    }
} else {
    // "both": unveraendertes Einzel-STL (Vorlage + erhabener Code als ein Volumen).
    union() {
        lock_base();
        code_solid();
    }
}
